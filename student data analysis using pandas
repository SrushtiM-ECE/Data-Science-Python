import pandas as pd
import matplotlib.pyplot as plt

# Step 1: Create sample dataset (you can replace with your own)
data = {
    'student_id': [1, 2, 3, 4, 5],
    'name': ['Asha', 'Ravi', 'Kiran', 'Meena', 'Arjun'],
    'marks': [85, 35, 60, 25, 90],
    'attendance': [90, 60, 75, 50, 95]
}

df = pd.DataFrame(data)

# Step 2: Display dataset
print("Dataset:\n", df)

# Step 3: Identify weak students (marks < 40)
weak_students = df[df['marks'] < 40]
print("\nWeak Students:\n", weak_students)

# Step 4: Calculate average marks
avg_marks = df['marks'].mean()
print("\nAverage Marks:", avg_marks)

# Step 5: Find top performer
top_student = df[df['marks'] == df['marks'].max()]
print("\nTop Performer:\n", top_student)

# Step 6: Visualization (Marks vs Attendance)
plt.scatter(df['attendance'], df['marks'])
plt.xlabel("Attendance")
plt.ylabel("Marks")
plt.title("Marks vs Attendance")
plt.show()
