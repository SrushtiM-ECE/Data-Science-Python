----------------------------------------------------
-- CREATE VIEW
----------------------------------------------------

CREATE VIEW hospital_report AS
SELECT
    p.patient_name,
    d.doctor_name,
    d.specialization,
    a.fees
FROM patients p
JOIN appointments a
ON p.patient_id = a.patient_id
JOIN doctors d
ON a.doctor_id = d.doctor_id;

----------------------------------------------------
-- DISPLAY VIEW
----------------------------------------------------

SELECT * FROM hospital_report;

