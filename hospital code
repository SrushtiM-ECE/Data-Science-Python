----------------------------------------------------
-- SHOW PATIENT NAME, DOCTOR NAME, SPECIALIZATION
----------------------------------------------------

SELECT
    p.patient_name,
    d.doctor_name,
    d.specialization
FROM patients p
JOIN appointments a
ON p.patient_id = a.patient_id
JOIN doctors d
ON a.doctor_id = d.doctor_id;

----------------------------------------------------
-- FIND TOTAL FEES COLLECTED
----------------------------------------------------

SELECT
    SUM(fees) AS total_fees
FROM appointments;

----------------------------------------------------
-- FIND HIGHEST PAID DOCTOR
----------------------------------------------------

SELECT *
FROM doctors
WHERE salary = (
    SELECT MAX(salary)
    FROM doctors
);

----------------------------------------------------
