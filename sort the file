def calculate_median(numbers):

    # Sort the list
    numbers.sort()

    n = len(numbers)

    # Check if the number of elements is even or odd
    if n % 2 == 0:
        middle1 = numbers[n // 2 - 1]
        middle2 = numbers[n // 2]
        median = (middle1 + middle2) / 2
    else:
        median = numbers[n // 2]

    return median


# Example input
data = [12, 5, 8, 20, 10]

# Function call
result = calculate_median(data)

print("Median:", result)
