----------------------------------------------------
-- CREATE VIEW
----------------------------------------------------

CREATE VIEW order_report AS
SELECT
    c.customer_name,
    p.product_name,
    o.quantity,
    (p.price * o.quantity) AS total_price
FROM customers c
JOIN orders o
ON c.customer_id = o.customer_id
JOIN products p
ON o.product_id = p.product_id;

