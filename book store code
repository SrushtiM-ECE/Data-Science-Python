----------------------------------------------------
-- CREATE VIEW
----------------------------------------------------

CREATE VIEW library_report AS
SELECT
    m.member_name,
    b.book_title,
    i.issue_date,
    i.return_date
FROM members m
JOIN issues i
ON m.member_id = i.member_id
JOIN books b
ON i.book_id = b.book_id;

----------------------------------------------------
-- DISPLAY VIEW
----------------------------------------------------

SELECT * FROM library_report;

