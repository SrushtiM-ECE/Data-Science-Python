----------------------------------------------------
-- SHOW MEMBER NAME AND BOOK TITLE
----------------------------------------------------

SELECT
    m.member_name,
    b.book_title,
    i.issue_date,
    i.return_date
FROM members m
JOIN issues i
ON m.member_id = i.member_id
JOIN books b
ON i.book_id = b.book_id;

----------------------------------------------------
-- FIND MOST EXPENSIVE BOOK
----------------------------------------------------

SELECT *
FROM books
WHERE price = (
    SELECT MAX(price)
    FROM books
);

----------------------------------------------------
-- COUNT TOTAL BOOKS
----------------------------------------------------

SELECT COUNT(*) AS total_books
FROM books;

