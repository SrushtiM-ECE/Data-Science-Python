----------------------------------------------------
-- CREATE A VIEW
----------------------------------------------------

CREATE VIEW student_report AS
SELECT 
    s.student_name,
    sub.subject_name,
    m.marks
FROM students s
JOIN marks m
ON s.student_id = m.student_id
JOIN subjects sub
ON m.subject_id = sub.subject_id;

----------------------------------------------------
-- DISPLAY VIEW
----------------------------------------------------

SELECT * FROM student_report;

