----------------------------------------------------
-- JOIN QUERY
-- SHOW STUDENT NAME, SUBJECT, AND MARKS
----------------------------------------------------

SELECT 
    s.student_name,
    sub.subject_name,
    m.marks
FROM students s
JOIN marks m
ON s.student_id = m.student_id
JOIN subjects sub
ON m.subject_id = sub.subject_id;

----------------------------------------------------
-- FIND AVERAGE MARKS OF EACH STUDENT
----------------------------------------------------

SELECT 
    s.student_name,
    AVG(m.marks) AS average_marks
FROM students s
JOIN marks m
ON s.student_id = m.student_id
GROUP BY s.student_name;

----------------------------------------------------
-- FIND TOPPER
----------------------------------------------------

SELECT 
    s.student_name,
    AVG(m.marks) AS average_marks
FROM students s
JOIN marks m
ON s.student_id = m.student_id
GROUP BY s.student_name
ORDER BY average_marks DESC;

----------------------------------------------------
-- FIND STUDENTS WITH MARKS LESS THAN 75
----------------------------------------------------

SELECT 
    s.student_name,
    sub.subject_name,
    m.marks
FROM students s
JOIN marks m
ON s.student_id = m.student_id
JOIN subjects sub
ON m.subject_id = sub.subject_id
WHERE m.marks < 75;

